# Copy to .env (git-ignored) or export in your shell / systemd unit.
# Free proof of concept: the public endpoint works (rate-limited); a free Helius / Alchemy / dRPC key is steadier.
#   RPC_URL=https://api.mainnet-beta.solana.com
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# only for the paid gRPC feed (Path B)
GEYSER_X_TOKEN=your-grpc-token
KEYSTORE_PASSPHRASE=a-long-random-passphrase
DATABASE_URL=postgres://copybot:password@localhost/copybot
RUST_LOG=info
GMGN_API_KEY=your-gmgn-openapi-key
